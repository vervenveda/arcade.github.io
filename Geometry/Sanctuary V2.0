<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="Sacred Geometry Sanctuary V2.0 — Mandala Builder, Geometry Battle, Geometry Lab, Player Guide and local Sanctuary Library.">
<meta name="theme-color" content="#080b13">
<meta name="color-scheme" content="dark">
<meta name="referrer" content="same-origin">
<meta http-equiv="Content-Security-Policy" content="default-src 'self' blob: data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none';">
<title>Sacred Geometry Sanctuary — V2.0</title>
<style>
:root{
 --bg:#080b13;--bg2:#0b111a;--panel:#131d29;--panel2:#182432;--screen:#07131c;
 --ink:#f3f4f1;--soft:#d4d9de;--muted:#adb8c3;--faint:#788491;
 --gold:#d9b878;--gold2:#f1d99d;--cyan:#68c9dd;--cyan2:#ace8ef;
 --rose:#c875a8;--violet:#8c7ed7;--mint:#79c8ad;--red:#ca6d78;
 --line:rgba(172,232,239,.15);--line2:rgba(172,232,239,.30);
 --shadow:0 24px 66px rgba(0,0,0,.34);--smallshadow:0 12px 33px rgba(0,0,0,.25);
 --r:8px;--display:"Eurostile Extended","Microgramma D Extended","Bank Gothic","Arial Narrow","Trebuchet MS",sans-serif;
 --sans:"Trebuchet MS",Verdana,"Segoe UI",sans-serif;--mono:"Courier New",ui-monospace,SFMono-Regular,Menlo,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:82px;font-synthesis:none}
body{margin:0;min-width:300px;min-height:100vh;overflow-x:hidden;color:var(--ink);background:var(--bg);font:14px/1.65 var(--sans)}
body:before{content:"";position:fixed;inset:0;z-index:-3;pointer-events:none;background:radial-gradient(circle at 14% -3%,rgba(104,201,221,.075),transparent 31rem),radial-gradient(circle at 88% 6%,rgba(217,184,120,.07),transparent 29rem),linear-gradient(180deg,#080b13,#0b111a 50%,#070a10)}
body:after{content:"";position:fixed;inset:0;z-index:-2;pointer-events:none;opacity:.5;background-image:linear-gradient(rgba(140,126,215,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(104,201,221,.03) 1px,transparent 1px);background-size:33px 33px}
body[data-motion="reduced"] *,body[data-motion="reduced"] *:before,body[data-motion="reduced"] *:after{animation:none!important;transition:none!important}
a{color:inherit}button,input,select{font:inherit}button{color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--cyan2);outline-offset:3px}[hidden]{display:none!important}
.wrap{width:min(calc(100% - 22px),1240px);margin-inline:auto}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.site-header{position:sticky;top:0;z-index:1200;border-bottom:1px solid var(--line);background:rgba(8,11,19,.94);backdrop-filter:blur(18px);box-shadow:0 11px 33px rgba(0,0,0,.25)}
.header-inner{min-height:66px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:14px;padding:7px 0}
.brand{justify-self:start;display:flex;align-items:center;gap:11px;text-decoration:none}.brand-mark{width:44px;height:44px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#1b1207;background:linear-gradient(145deg,var(--gold2),var(--gold));font:11px var(--display);box-shadow:0 0 22px rgba(217,184,120,.14)}
.brand-copy{display:grid;line-height:1.05}.brand-copy strong{font:11px var(--display);letter-spacing:.14em;text-transform:uppercase}.brand-copy small{margin-top:7px;color:var(--muted);font:11px var(--mono)}
.game-id{text-align:center}.game-id strong{display:block;font:14px var(--display);letter-spacing:.18em;text-transform:uppercase}.game-id small{display:block;margin-top:3px;color:var(--cyan);font:11px var(--mono);letter-spacing:.11em;text-transform:uppercase}.header-state{justify-self:end;color:var(--muted);font:11px var(--mono);text-align:right}.header-state strong{color:var(--mint)}
.intro{text-align:center;padding:48px 0 28px}.open-line{display:inline-flex;gap:11px;align-items:center;color:var(--mint);font:11px var(--mono);letter-spacing:.14em;text-transform:uppercase}.open-dot{width:7px;height:7px;border-radius:50%;background:var(--mint);box-shadow:0 0 14px rgba(121,200,173,.38)}
.intro h1{margin:22px auto 0;font:clamp(46px,7vw,82px)/.88 var(--display);letter-spacing:-.06em;text-transform:uppercase;text-shadow:3px 3px 0 rgba(104,201,221,.17),-3px -3px 0 rgba(217,184,120,.15)}
.intro p{max-width:860px;margin:22px auto 0;color:var(--soft);font-size:16px;line-height:1.8}
.studio{display:grid;grid-template-columns:minmax(330px,.44fr) minmax(450px,.56fr);gap:14px;align-items:start;padding:14px;border:1px solid var(--line2);border-radius:var(--r);background:linear-gradient(180deg,#0c131e,#090e16);box-shadow:var(--shadow)}
.stack{display:grid;gap:11px}.panel{min-width:0;padding:14px;border:1px solid var(--line);border-radius:var(--r);background:linear-gradient(160deg,#162230,#0d151f);box-shadow:var(--smallshadow)}
.panel h2,.panel h3{margin:0;font-family:var(--display);letter-spacing:.02em;text-transform:uppercase}.panel h2{font-size:24px}.panel h3{font-size:16px}.sub{margin:7px 0 0;color:var(--muted);font-size:13px}
.control-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:14px}.control-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.control{display:grid;gap:7px;min-width:0}.full{grid-column:1/-1}
.control label{display:flex;justify-content:space-between;gap:7px;color:var(--muted);font:11px var(--mono);letter-spacing:.06em;text-transform:uppercase}.control output{color:var(--cyan2)}
input[type=text],select{width:100%;min-height:44px;padding:7px 11px;border:1px solid var(--line);border-radius:var(--r);color:var(--ink);background:var(--screen)}input[type=color]{width:100%;height:44px;padding:3px;border:1px solid var(--line);border-radius:var(--r);background:var(--screen)}input[type=range]{width:100%;accent-color:var(--cyan)}
.button-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin-top:11px}.btn{min-height:42px;padding:7px 11px;border:1px solid var(--line);border-radius:var(--r);color:var(--soft);background:var(--panel2);font:11px var(--mono);text-transform:uppercase;letter-spacing:.05em}.btn:hover:not(:disabled){color:var(--cyan2);border-color:var(--cyan);transform:translateY(-1px)}.btn:disabled{opacity:.38;cursor:not-allowed}.primary{color:#071018!important;border-color:var(--cyan)!important;background:linear-gradient(135deg,var(--cyan2),var(--cyan))!important}.gold{color:#1b1207!important;border-color:var(--gold)!important;background:linear-gradient(135deg,var(--gold2),var(--gold))!important}.danger{color:#fff!important;border-color:var(--red)!important;background:var(--red)!important}
.status{min-height:48px;display:flex;align-items:center;gap:11px;margin-top:11px;padding:11px 14px;border:1px solid var(--line);border-radius:var(--r);color:var(--soft);background:var(--screen);font:12px var(--mono)}.status-dot{width:7px;height:7px;flex:0 0 7px;border-radius:50%;background:var(--mint);box-shadow:0 0 11px rgba(121,200,173,.32)}
.layer-list,.library-list,.battle-log{max-height:320px;overflow:auto;display:grid;gap:7px;margin-top:11px;padding-right:3px}.empty{padding:24px;border:1px dashed var(--line2);border-radius:var(--r);color:var(--muted);background:var(--screen);text-align:center}
.layer-row,.save-row{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:9px;align-items:center;padding:7px;border:1px solid var(--line);border-radius:var(--r);background:var(--screen)}.layer-row.selected{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(104,201,221,.07)}.swatch{width:33px;height:33px;border:1px solid rgba(255,255,255,.24);border-radius:50%}.row-copy{min-width:0}.row-copy strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.row-copy small{display:block;margin-top:3px;color:var(--muted);font:10px var(--mono)}.row-actions{display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end}.icon-btn{min-width:33px;height:33px;display:grid;place-items:center;padding:0 7px;border:1px solid var(--line);border-radius:var(--r);color:var(--muted);background:var(--panel2)}.icon-btn:hover{color:var(--cyan2);border-color:var(--cyan)}.icon-btn.favorite{color:#1b1207;border-color:var(--gold);background:var(--gold)}
.stage-panel{position:sticky;top:88px;min-width:0;padding:14px;border:1px solid var(--line);border-radius:var(--r);background:linear-gradient(160deg,#162230,#0d151f);box-shadow:var(--smallshadow)}
.stage-top{display:flex;justify-content:space-between;gap:14px;margin-bottom:11px;color:var(--muted);font:11px var(--mono);text-transform:uppercase}.stage-top strong{color:var(--gold2)}
.mandala-stage{position:relative;width:100%;aspect-ratio:1;overflow:hidden;border:7px solid #05080d;border-radius:var(--r);background:radial-gradient(circle at 50% 50%,rgba(140,126,215,.12),transparent 31%),radial-gradient(circle at 50% 50%,#101a28,#071018 69%,#05080d);box-shadow:inset 0 0 44px rgba(0,0,0,.62),0 22px 55px rgba(0,0,0,.35)}
.mandala-stage:after{content:"";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(to bottom,transparent 0 3px,rgba(255,255,255,.018) 3px 4px)}
#mandalaSvg{position:absolute;inset:0;width:100%;height:100%}#mandalaSvg .guide{fill:none;stroke:rgba(172,232,239,.08);stroke-width:1}#mandalaSvg .axis{stroke:rgba(217,184,120,.055);stroke-width:.7}#mandalaSvg .halo{animation:haloPulse 3.4s ease-in-out infinite}#mandalaSvg .layer-group{transform-box:view-box;transform-origin:260px 260px;animation:layerBreathe var(--duration,5s) ease-in-out infinite}#mandalaSvg .selected-layer{filter:drop-shadow(0 0 7px rgba(172,232,239,.52))}
@keyframes haloPulse{0%,100%{opacity:.48;transform:scale(.94)}50%{opacity:.78;transform:scale(1.05)}}@keyframes layerBreathe{0%,100%{opacity:.84}50%{opacity:1}}
.stage-caption{margin-top:11px;color:var(--muted);font:11px var(--mono);text-align:center}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:11px}.metric{padding:10px 7px;border:1px solid var(--line);border-radius:var(--r);background:var(--screen);text-align:center}.metric strong{display:block;color:var(--cyan2);font:20px var(--mono)}.metric:nth-child(2) strong{color:var(--gold2)}.metric:nth-child(3) strong{color:#e6a1cc}.metric:nth-child(4) strong{color:var(--mint)}.metric span{display:block;margin-top:3px;color:var(--muted);font:10px var(--mono);text-transform:uppercase}
.section{padding:58px 0 20px}.section-head{max-width:820px;margin:0 auto 27px;text-align:center}.eyebrow{color:var(--gold);font:11px var(--mono);letter-spacing:.15em;text-transform:uppercase}.section-head h2{margin:10px 0 0;font:clamp(32px,5vw,54px)/1 var(--display);text-transform:uppercase}.section-head p:last-child{color:var(--muted)}
.cabinet{padding:14px;border:1px solid var(--line2);border-radius:var(--r);background:linear-gradient(180deg,#0c131e,#090e16);box-shadow:var(--shadow)}.duel-grid{display:grid;grid-template-columns:minmax(320px,.42fr) minmax(430px,.58fr);gap:14px}.resonance-map,.bonus-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:7px;margin-top:11px}.bonus-grid{grid-template-columns:repeat(4,1fr)}.resonance,.combatant,.duel-board{padding:11px;border:1px solid var(--line);border-radius:var(--r);background:var(--screen)}.resonance strong{display:block;color:var(--gold2);font:11px var(--mono);text-transform:uppercase}.resonance span{color:var(--muted);font-size:12px}
.combatant-head{display:flex;justify-content:space-between;font-family:var(--display);text-transform:uppercase}.combatant-head span:last-child{font:11px var(--mono);color:var(--muted)}.bar-track{height:11px;margin-top:9px;overflow:hidden;border:1px solid var(--line);border-radius:var(--r);background:#03070b}.bar-fill{height:100%;border-radius:var(--r);transition:width .28s ease}.health-player{background:linear-gradient(90deg,var(--mint),var(--cyan))}.health-ai{background:linear-gradient(90deg,var(--rose),var(--gold))}.energy{background:linear-gradient(90deg,var(--violet),var(--cyan))}.combatant-meta{display:flex;justify-content:space-between;margin-top:6px;color:var(--muted);font:10px var(--mono)}.battle-log{max-height:250px}.log{padding:7px 9px;border-left:3px solid var(--cyan);color:var(--soft);background:var(--panel2);font-size:12px}.log.ai{border-color:var(--rose)}.log.system{border-color:var(--gold)}.result{padding:13px;border:1px solid var(--line2);border-radius:var(--r);text-align:center;background:linear-gradient(135deg,rgba(104,201,221,.08),rgba(217,184,120,.08))}
.lab-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.formula{padding:18px;border:1px solid var(--line);border-radius:var(--r);background:var(--screen);text-align:center;font:24px var(--mono);color:var(--cyan2)}.explain{color:var(--soft)}.test-list{display:grid;gap:6px;margin-top:10px}.test{padding:7px 9px;border-left:3px solid var(--mint);background:var(--screen);font:11px var(--mono)}.test.fail{border-color:var(--red)}
.guide{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.guide-card{padding:15px;border:1px solid var(--line);border-radius:var(--r);background:var(--screen)}.guide-card h3{margin:0 0 7px;font:15px var(--display);text-transform:uppercase}.guide-card p,.guide-card li{color:var(--soft);font-size:13px}.guide-card ul{padding-left:20px;margin:8px 0 0}
.footer{padding:24px 0 36px;color:var(--muted);text-align:center;font:11px var(--mono)}.toast{position:fixed;right:14px;bottom:14px;z-index:3000;max-width:min(400px,calc(100% - 28px));padding:11px 14px;border:1px solid var(--cyan);border-radius:var(--r);color:var(--ink);background:var(--panel);box-shadow:var(--shadow);font:11px var(--mono);transform:translateY(160%);opacity:0;transition:.18s ease}.toast.show{transform:none;opacity:1}
@media(max-width:1040px){.header-inner{grid-template-columns:1fr auto}.game-id{display:none}.studio,.duel-grid{grid-template-columns:1fr}.stage-panel{position:relative;top:auto;order:-1}}
@media(max-width:760px){body{font-size:15px}.control-grid,.control-grid.three{grid-template-columns:1fr}.button-row{grid-template-columns:1fr 1fr}.stats,.bonus-grid,.guide,.lab-grid{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.wrap{width:min(calc(100% - 14px),1240px)}.brand-copy small{display:none}.intro{padding-top:33px}.intro h1{font-size:49px}.panel,.stage-panel,.cabinet{padding:11px}.button-row{grid-template-columns:1fr 1fr}.guide,.lab-grid{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<a class="sr-only" href="#studio">Skip to studio</a>
<header class="site-header">
 <div class="wrap header-inner">
  <a class="brand" href="#top" aria-label="Sacred Geometry Sanctuary home"><span class="brand-mark">SG</span><span class="brand-copy"><strong>Geometry Sanctuary</strong><small>ARCADE / V2.0</small></span></a>
  <div class="game-id"><strong>Sacred Geometry Sanctuary</strong><small>Mandala Builder · Geometry Battle · Geometry Lab</small></div>
  <div class="header-state">LOCAL MODE<br><strong>NO NETWORK</strong></div>
 </div>
</header>

<main id="top" class="wrap">
<section class="intro">
 <div class="open-line"><span class="open-dot"></span>V2.0 ENGINE ONLINE</div>
 <h1>Build the Field.<br>Play the Geometry.</h1>
 <p>Turn an intention into a deterministic color seed, build true radial geometry one editable layer at a time, preserve favorite sanctuaries, export artwork, learn the mathematical forms, and use your composition as a tactical advantage in Geometry Battle.</p>
</section>

<section id="studio" class="studio" aria-label="Sacred geometry studio">
<div class="stack">
 <section class="panel">
  <h2>Intention Seed</h2><p class="sub">The same intention always generates the same harmonic palette. Manifesting creates a three-layer foundation.</p>
  <div class="control-grid"><div class="control full"><label for="intentInput">Sacred intention</label><input id="intentInput" type="text" maxlength="80" placeholder="Courage and clarity" autocomplete="off"></div></div>
  <div class="button-row"><button class="btn gold" id="manifestBtn" type="button">Manifest</button><button class="btn" id="surpriseBtn" type="button">Surprise Me</button><button class="btn" id="undoBtn" type="button">Undo</button><button class="btn" id="redoBtn" type="button">Redo</button></div>
  <div id="status" class="status" role="status" aria-live="polite"><span class="status-dot"></span><span id="statusText">Ready to receive an intention.</span></div>
 </section>
 <section class="panel">
  <h3>Layer Builder</h3><p class="sub">Each layer is repeated around a true radial ring. Select a layer below to edit it.</p>
  <div class="control-grid three">
   <div class="control"><label for="themeSelect">Theme</label><select id="themeSelect"><option value="healing">Healing</option><option value="courage">Courage</option><option value="focus">Focus</option><option value="love">Love</option><option value="clarity">Clarity</option></select></div>
   <div class="control"><label for="shapeSelect">Motif</label><select id="shapeSelect"><option value="circle">Circle</option><option value="triangle">Triangle</option><option value="square">Square</option><option value="hexagon">Hexagon</option><option value="star">Star</option><option value="lotus">Lotus</option><option value="spiral">Spiral</option></select></div>
   <div class="control"><label for="styleSelect">Rendering</label><select id="styleSelect"><option value="filled">Filled</option><option value="outline">Outline</option><option value="weave">Weave</option></select></div>
   <div class="control"><label for="colorInput">Color</label><input id="colorInput" type="color" value="#d9b878"></div>
   <div class="control"><label for="countRange">Repetitions <output id="countOutput">8</output></label><input id="countRange" type="range" min="3" max="24" value="8"></div>
   <div class="control"><label for="radiusRange">Ring radius <output id="radiusOutput">92</output></label><input id="radiusRange" type="range" min="36" max="205" value="92"></div>
   <div class="control"><label for="rotationRange">Rotation <output id="rotationOutput">0°</output></label><input id="rotationRange" type="range" min="0" max="359" value="0"></div>
   <div class="control"><label for="scaleRange">Scale <output id="scaleOutput">1.0</output></label><input id="scaleRange" type="range" min="5" max="18" value="10"></div>
   <div class="control"><label for="opacityRange">Opacity <output id="opacityOutput">90%</output></label><input id="opacityRange" type="range" min="25" max="100" value="90"></div>
  </div>
  <div class="button-row"><button id="addLayerBtn" class="btn primary" type="button">Add Layer</button><button id="updateLayerBtn" class="btn" type="button" disabled>Update</button><button id="duplicateBtn" class="btn" type="button" disabled>Duplicate</button><button id="deleteLayerBtn" class="btn danger" type="button" disabled>Delete</button></div>
  <div class="button-row"><button id="moveUpBtn" class="btn" type="button" disabled>Move Up</button><button id="moveDownBtn" class="btn" type="button" disabled>Move Down</button><button id="toggleVisibleBtn" class="btn" type="button" disabled>Hide/Show</button><button id="resetControlsBtn" class="btn" type="button">Defaults</button></div>
 </section>
 <section class="panel">
  <h3>Layer Stack</h3><p class="sub">Top rows render above lower rows. Select any layer to edit it.</p><div id="layerList" class="layer-list"></div>
 </section>
 <section class="panel">
  <h3>Sanctuary Library</h3><p class="sub">Local-only saved compositions. Nothing is uploaded.</p>
  <div class="button-row"><button id="saveBtn" class="btn primary" type="button">Save</button><button id="exportLibraryBtn" class="btn" type="button">Export Library</button><button id="importLibraryBtn" class="btn" type="button">Import Library</button><button id="clearLibraryBtn" class="btn danger" type="button">Clear Library</button></div>
  <input id="importLibraryInput" type="file" accept=".json,application/json" hidden><div id="libraryList" class="library-list"></div>
 </section>
</div>

<div class="stage-panel">
 <div class="stage-top"><span>Composition</span><strong id="intentionLabel">PLERA</strong></div>
 <div class="mandala-stage">
  <svg id="mandalaSvg" viewBox="0 0 520 520" role="img" aria-labelledby="svgTitle svgDesc">
   <title id="svgTitle">Sacred geometry mandala</title><desc id="svgDesc">A locally generated radial geometry composition.</desc>
   <circle class="guide" cx="260" cy="260" r="64"/><circle class="guide" cx="260" cy="260" r="116"/><circle class="guide" cx="260" cy="260" r="178"/>
   <line class="axis" x1="40" y1="260" x2="480" y2="260"/><line class="axis" x1="260" y1="40" x2="260" y2="480"/>
   <circle id="haloCircle" class="halo" cx="260" cy="260" r="205" fill="#68c9dd" opacity=".12"/>
   <text id="svgIntention" x="260" y="267" fill="rgba(255,255,255,.18)" text-anchor="middle" font-family="monospace" font-size="12" letter-spacing="3">PLERA</text>
   <g id="layersGroup"></g>
  </svg>
 </div>
 <div class="stage-caption">Mathematical forms and artistic motifs are clearly distinguished in the Geometry Lab below.</div>
 <div class="stats"><div class="metric"><strong id="attackMetric">0</strong><span>Attack</span></div><div class="metric"><strong id="defenseMetric">0</strong><span>Defense</span></div><div class="metric"><strong id="renewalMetric">0</strong><span>Renewal</span></div><div class="metric"><strong id="harmonyMetric">0</strong><span>Harmony</span></div></div>
 <div class="button-row"><button id="exportSvgBtn" class="btn primary" type="button">Export SVG</button><button id="exportPngBtn" class="btn" type="button">Export PNG</button><button id="reduceMotionBtn" class="btn" type="button">Reduce Motion</button><button id="testBtn" class="btn" type="button">Run Tests</button></div>
</div>
</section>

<section class="section" aria-labelledby="duelTitle">
 <div class="section-head"><div class="eyebrow">Tactical Geometry</div><h2 id="duelTitle">Geometry Battle</h2><p>The player, AI evaluator, and round resolver use the same combat mathematics. Regeneration never resurrects a defeated combatant.</p></div>
 <div class="cabinet duel-grid">
  <div class="stack">
   <section class="panel">
    <h3>Resonance Cycle</h3>
    <div class="resonance-map"><div class="resonance"><strong>Circle → Triangle</strong><span>Triangle counters Circle.</span></div><div class="resonance"><strong>Triangle → Square</strong><span>Square counters Triangle.</span></div><div class="resonance"><strong>Square → Spiral</strong><span>Spiral counters Square.</span></div><div class="resonance"><strong>Spiral → Circle</strong><span>Circle counters Spiral.</span></div></div>
    <div class="control-grid"><div class="control"><label for="stanceSelect">Your Stance</label><select id="stanceSelect"></select></div><div class="control"><label for="duelLevelSelect">AI Level</label><select id="duelLevelSelect"><option value="gentle">Gentle</option><option value="oracle">Oracle</option><option value="eclipse">Eclipse</option></select></div></div>
    <div class="button-row"><button id="beginDuelBtn" class="btn primary" type="button">Begin Duel</button><button id="resolveRoundBtn" class="btn gold" type="button" disabled>Resolve Round</button><button id="resetDuelBtn" class="btn" type="button">Reset</button><button id="roundInfoBtn" class="btn" type="button">How It Works</button></div>
   </section>
   <section class="panel"><h3>Sanctuary Bonuses</h3><p class="sub">Harmony also improves energy recovery. Bonuses are capped to keep composition from creating runaway power.</p><div class="bonus-grid"><div class="metric"><strong id="duelAttack">0</strong><span>Attack</span></div><div class="metric"><strong id="duelDefense">0</strong><span>Defense</span></div><div class="metric"><strong id="duelRenewal">0</strong><span>Renewal</span></div><div class="metric"><strong id="duelHarmony">0</strong><span>Harmony</span></div></div></section>
  </div>
  <div class="duel-board">
   <div class="combatant"><div class="combatant-head"><span>You</span><span id="playerStanceLabel">—</span></div><div class="bar-track"><div id="playerHpBar" class="bar-fill health-player" style="width:100%"></div></div><div class="combatant-meta"><span>HP <strong id="playerHp">60</strong>/60</span><span>Energy <strong id="playerEnergy">8</strong>/10</span></div><div class="bar-track"><div id="playerEnergyBar" class="bar-fill energy" style="width:80%"></div></div></div>
   <div class="combatant"><div class="combatant-head"><span>Geometry AI</span><span id="aiStanceLabel">—</span></div><div class="bar-track"><div id="aiHpBar" class="bar-fill health-ai" style="width:100%"></div></div><div class="combatant-meta"><span>HP <strong id="aiHp">60</strong>/60</span><span>Energy <strong id="aiEnergy">8</strong>/10</span></div><div class="bar-track"><div id="aiEnergyBar" class="bar-fill energy" style="width:80%"></div></div></div>
   <div id="battleResult" class="result" hidden></div><div id="battleLog" class="battle-log" aria-live="polite"></div>
  </div>
 </div>
</section>

<section class="section" aria-labelledby="labTitle">
 <div class="section-head"><div class="eyebrow">Geometry Lab</div><h2 id="labTitle">Learn the Forms</h2><p>These references describe mathematical properties where applicable; lotus and mandala styling are treated as artistic constructions rather than mathematical claims.</p></div>
 <div class="lab-grid">
  <section class="panel"><h3 id="labShapeTitle">Triangle</h3><p id="labShapeText" class="explain"></p><div id="labFormula" class="formula"></div><p id="labFact" class="sub"></p></section>
  <section class="panel"><h3>Geometry Integrity Tests</h3><p class="sub">The test suite checks counter relationships, HP/energy bounds, polygon construction, deterministic palettes, and non-resurrection behavior.</p><div id="testResults" class="test-list"><div class="empty">Run Tests from the studio.</div></div></section>
 </div>
</section>

<section class="section" aria-labelledby="guideTitle">
 <div class="section-head"><div class="eyebrow">Player Guide</div><h2 id="guideTitle">The Sanctuary Manual</h2><p>This combines the former player guide with the game itself, so the controls and explanations live in the same file.</p></div>
 <div class="guide">
  <article class="guide-card"><h3>1 · Manifest</h3><p>Enter a short intention and choose <b>Manifest</b>. The intention becomes a deterministic color seed and creates a three-layer starting composition.</p></article>
  <article class="guide-card"><h3>2 · Build</h3><p>Use the Layer Builder to choose a theme, motif, rendering style, color, repetitions, radius, rotation, scale, and opacity. Add as many as 18 layers.</p></article>
  <article class="guide-card"><h3>3 · Edit</h3><p>Select a layer to edit it. Use Update, Duplicate, Move Up/Down, Hide/Show, Delete, Undo, and Redo. Surprise Me is recorded as one history action.</p></article>
  <article class="guide-card"><h3>4 · Save</h3><p>Save sanctuaries locally in your browser. Pin favorites, reload saved work, delete entries, or export/import the complete library as JSON.</p></article>
  <article class="guide-card"><h3>5 · Export</h3><p>Export a clean SVG or a PNG of the visible composition. Exported SVGs omit guides, axes, selection effects, and animation-only styling.</p></article>
  <article class="guide-card"><h3>6 · Battle</h3><p>Begin a duel, choose your stance, then resolve each round. Counter relationships, composition bonuses, energy, defense, renewal, and bounded randomness determine the outcome.</p></article>
  <article class="guide-card"><h3>7 · Counter Cycle</h3><ul><li>Triangle counters Circle.</li><li>Square counters Triangle.</li><li>Spiral counters Square.</li><li>Circle counters Spiral.</li></ul></article>
  <article class="guide-card"><h3>8 · AI</h3><p><b>Gentle</b> is mostly random. <b>Oracle</b> responds to recent behavior. <b>Eclipse</b> evaluates likely stances using the same round model used by the actual battle resolver.</p></article>
  <article class="guide-card"><h3>9 · Local First</h3><p>The application uses browser storage only for local persistence. It has no fetch/XHR/WebSocket calls, no analytics, and no external font dependency.</p></article>
 </div>
</section>
</main>
<footer class="wrap footer">ARSHIF Arcade · Sacred Geometry Sanctuary V2.0 · Local-first educational game · Standalone single-file build.</footer>
<div id="toast" class="toast" role="status" aria-live="polite"></div>

<script>
"use strict";
const VERSION="2.0.0", SVG_NS="http://www.w3.org/2000/svg";
const MAX_LAYERS=18,MAX_SAVES=40,MAX_LIBRARY_BYTES=1024*1024,MAX_HP=60,MAX_ENERGY=10,MAX_ROUNDS=12;
const SAVE_KEY="sgs_v2_library",MOTION_KEY="sgs_v2_reduced_motion";
const $=id=>document.getElementById(id);
const clamp=(n,a,b)=>Math.min(b,Math.max(a,n));
const deepClone=o=>JSON.parse(JSON.stringify(o));
const safeText=v=>String(v??"").replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/g,"");
const uid=prefix=>`${prefix}_${Date.now().toString(36)}_${Math.random().toString(36).slice(2,8)}`;
const hex=v=>/^#[0-9a-f]{6}$/i.test(v)?v:"#68c9dd";

const THEMES={
 healing:{label:"Healing",attack:1,defense:3,renewal:4,harmony:2},
 courage:{label:"Courage",attack:4,defense:1,renewal:1,harmony:2},
 focus:{label:"Focus",attack:3,defense:2,renewal:1,harmony:3},
 love:{label:"Love",attack:1,defense:2,renewal:3,harmony:4},
 clarity:{label:"Clarity",attack:2,defense:3,renewal:2,harmony:4}
};
const SHAPES={
 circle:{label:"Circle",attack:1,defense:3,renewal:2,harmony:3},
 triangle:{label:"Triangle",attack:4,defense:1,renewal:1,harmony:2},
 square:{label:"Square",attack:2,defense:4,renewal:1,harmony:2},
 hexagon:{label:"Hexagon",attack:2,defense:3,renewal:2,harmony:3},
 star:{label:"Star",attack:4,defense:1,renewal:1,harmony:3},
 lotus:{label:"Lotus",attack:1,defense:2,renewal:4,harmony:4},
 spiral:{label:"Spiral",attack:2,defense:1,renewal:4,harmony:3}
};
const COUNTERS={circle:"triangle",triangle:"square",square:"spiral",spiral:"circle"};
const COUNTER_TO={triangle:"circle",square:"triangle",spiral:"square",circle:"spiral"};
const PALETTE_OFFSETS=[0,44,138,220];
const LAB={
 circle:{title:"Circle",text:"A circle is the set of points in a plane at a constant distance from a center. Its radius is half its diameter.",formula:"A = πr²",fact:"Circumference: C = 2πr. Diameter: d = 2r."},
 triangle:{title:"Triangle",text:"A triangle has three sides and three vertices. The interior angles of every Euclidean triangle sum to 180°.",formula:"A = ½bh",fact:"An equilateral triangle has three equal sides and three 60° angles."},
 square:{title:"Square",text:"A square has four equal sides and four right angles. Opposite sides are parallel.",formula:"A = s²",fact:"Perimeter: P = 4s. Each interior angle is 90°."},
 hexagon:{title:"Hexagon",text:"A regular hexagon has six equal sides and six equal interior angles. It has sixfold rotational symmetry.",formula:"A = (3√3/2)s²",fact:"A regular hexagon has 120° interior angles."},
 star:{title:"Star",text:"The star motif here is a constructed radial figure. Its defining feature is rotational organization around a center rather than a single universal geometry formula.",formula:"θ = 360°/n",fact:"The engine uses alternating outer and inner radii for the five-point star."},
 lotus:{title:"Lotus",text:"The lotus is an artistic radial construction made from repeated rotated ellipses. It is intentionally treated as symbolic/artistic rather than as a standard mathematical polygon.",formula:"θ = 360°/n",fact:"The default lotus uses six petals separated by 60°."},
 spiral:{title:"Spiral",text:"The sanctuary spiral uses a discrete polar construction whose radius grows with the step index while its angle advances.",formula:"r ∝ θ",fact:"It is an Archimedean-style visual construction, rendered as a finite polyline."}
};

let intention="PLERA",palette=paletteFromString(intention),layers=[],selectedLayerId=null,undoStack=[],redoStack=[],library=[],duel=defaultDuel();

function hashString(str){
 let h=2166136261>>>0;
 for(let i=0;i<str.length;i++){h^=str.charCodeAt(i);h=Math.imul(h,16777619);}
 return h>>>0;
}
function paletteFromString(text){
 const base=hashString(text||"PLERA")%360;
 return PALETTE_OFFSETS.map(offset=>hslToHex((base+offset)%360,62,62));
}
function hslToHex(h,s,l){
 const a=s*Math.min(l,1-l)/100,c=(1-Math.abs(2*l/100-1))*s/100,x=c*(1-Math.abs((h/60)%2-1)),m=l/100-a;
 let r=0,g=0,b=0;
 if(h<60){r=c;g=x}else if(h<120){r=x;g=c}else if(h<180){g=c;b=x}else if(h<240){g=x;b=c}else if(h<300){r=x;b=c}else{r=c;b=x}
 return "#"+[r,g,b].map(v=>Math.round((v+m)*255).toString(16).padStart(2,"0")).join("");
}
function defaultLayer(overrides={}){
 return Object.assign({id:uid("layer"),theme:"healing",shape:"circle",style:"filled",color:palette[0],count:8,radius:92,rotation:0,scale:1,opacity:.9,visible:true},overrides);
}
function safeLayer(v){
 if(!v||typeof v!=="object")return null;
 const layer={
  id:safeText(v.id||uid("layer")).slice(0,80),
  theme:THEMES[v.theme]?v.theme:"healing",
  shape:SHAPES[v.shape]?v.shape:"circle",
  style:["filled","outline","weave"].includes(v.style)?v.style:"filled",
  color:hex(v.color),
  count:clamp(Number(v.count)||8,3,24),
  radius:clamp(Number(v.radius)||92,36,205),
  rotation:((Number(v.rotation)||0)%360+360)%360,
  scale:clamp(Number(v.scale)||1,.5,1.8),
  opacity:clamp(Number(v.opacity)||.9,.25,1),
  visible:v.visible!==false
 };
 return layer;
}
function normalizeSave(v){
 if(!v||typeof v!=="object")return null;
 return {id:safeText(v.id||uid("save")).slice(0,80),name:safeText(v.name||"Untitled Sanctuary").slice(0,48),intention:safeText(v.intention||"PLERA").slice(0,80),createdAt:Number.isFinite(Number(v.createdAt))?Number(v.createdAt):Date.now(),favorite:Boolean(v.favorite),palette:Array.isArray(v.palette)&&v.palette.length?v.palette.map(hex).slice(0,4):paletteFromString(v.intention||"PLERA"),layers:Array.isArray(v.layers)?v.layers.slice(0,MAX_LAYERS).map(safeLayer).filter(Boolean):[]};
}
function defaultDuel(){return {active:false,round:0,playerHp:MAX_HP,aiHp:MAX_HP,playerEnergy:8,aiEnergy:8,playerStance:"circle",aiStance:null,history:[],log:[],level:"oracle",result:""}}

function setStatus(msg,type="good"){
 $("statusText").textContent=msg;
 $("headerStatus").textContent=type==="bad"?"Attention":type==="warn"?"Check":"Ready";
 $("status").style.borderColor=type==="bad"?"var(--red)":type==="warn"?"var(--gold)":"var(--line)";
 showToast(msg);
}
let toastTimer;
function showToast(msg){
 const t=$("toast");t.textContent=msg;t.classList.add("show");clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove("show"),2200);
}

function remember(){
 undoStack.push({layers:deepClone(layers),intention,palette:[...palette],selectedLayerId});
 if(undoStack.length>80)undoStack.shift();redoStack=[];syncButtons();
}
function restore(snapshot){
 layers=deepClone(snapshot.layers);intention=snapshot.intention;palette=[...snapshot.palette];selectedLayerId=snapshot.selectedLayerId||layers.at(-1)?.id||null;
 $("intentInput").value=intention==="PLERA"?"":intention;$("intentionLabel").textContent=intention;$("svgIntention").textContent=intention.toUpperCase().slice(0,42);
 $("haloCircle").setAttribute("fill",palette[0]);if(selectedLayerId)loadLayerControls(layers.find(x=>x.id===selectedLayerId));renderAll();
}
function undo(){if(!undoStack.length)return;redoStack.push({layers:deepClone(layers),intention,palette:[...palette],selectedLayerId});restore(undoStack.pop());setStatus("Undo complete.","good");syncButtons()}
function redo(){if(!redoStack.length)return;undoStack.push({layers:deepClone(layers),intention,palette:[...palette],selectedLayerId});restore(redoStack.pop());setStatus("Redo complete.","good");syncButtons()}

function makeFoundation(){
 layers=[
  defaultLayer({shape:"circle",theme:"healing",color:palette[0],count:12,radius:64,scale:1.1,opacity:.7}),
  defaultLayer({shape:"triangle",theme:"focus",color:palette[1],count:8,radius:112,rotation:22.5,scale:.9,opacity:.78}),
  defaultLayer({shape:"lotus",theme:"love",color:palette[2],count:6,radius:166,rotation:0,scale:1.05,opacity:.58})
 ];
 selectedLayerId=layers.at(-1).id;
}
function manifest(){
 const text=safeText($("intentInput").value).trim().slice(0,80)||"PLERA";
 remember();intention=text;palette=paletteFromString(text);makeFoundation();loadLayerControls(layers.at(-1));renderAll();setStatus(`Manifested "${intention}".`,"good");
}
function surprise(){
 remember();
 const words=["Quiet Courage","Open Focus","Golden Clarity","Patient Strength","Creative Balance","Radiant Calm","Steady Curiosity","Kind Resolve"];
 const shapes=["circle","triangle","square","hexagon","star","lotus","spiral"],themes=Object.keys(THEMES);
 intention=words[Math.floor(Math.random()*words.length)];palette=paletteFromString(intention);
 layers=Array.from({length:3+Math.floor(Math.random()*3)},(_,i)=>defaultLayer({shape:shapes[Math.floor(Math.random()*shapes.length)],theme:themes[Math.floor(Math.random()*themes.length)],color:palette[i%palette.length],count:3+Math.floor(Math.random()*15),radius:52+i*42+Math.floor(Math.random()*20),rotation:Math.floor(Math.random()*360),scale:.7+Math.random()*.7,opacity:.45+Math.random()*.5}));
 selectedLayerId=layers.at(-1).id;$("intentInput").value=intention;loadLayerControls(layers.at(-1));renderAll();setStatus("A new sanctuary was composed as one history action.","good");
}
function readControls(){
 return safeLayer({theme:$("themeSelect").value,shape:$("shapeSelect").value,style:$("styleSelect").value,color:$("colorInput").value,count:$("countRange").value,radius:$("radiusRange").value,rotation:$("rotationRange").value,scale:Number($("scaleRange").value)/10,opacity:Number($("opacityRange").value)/100,visible:true});
}
function loadLayerControls(layer){
 if(!layer)return;
 $("themeSelect").value=layer.theme;$("shapeSelect").value=layer.shape;$("styleSelect").value=layer.style;$("colorInput").value=hex(layer.color);
 $("countRange").value=layer.count;$("radiusRange").value=layer.radius;$("rotationRange").value=layer.rotation;$("scaleRange").value=Math.round(layer.scale*10);$("opacityRange").value=Math.round(layer.opacity*100);syncOutputs();
}
function syncOutputs(){
 $("countOutput").value=$("countRange").value;$("radiusOutput").value=$("radiusRange").value;$("rotationOutput").value=`${$("rotationRange").value}°`;
 $("scaleOutput").value=(Number($("scaleRange").value)/10).toFixed(1);$("opacityOutput").value=`${$("opacityRange").value}%`;
}
function addLayer(){
 if(layers.length>=MAX_LAYERS)return setStatus(`Layer limit reached (${MAX_LAYERS}).`,"warn");
 remember();const layer=readControls();layer.id=uid("layer");layer.color=hex(layer.color||palette[layers.length%palette.length]);layers.push(layer);selectedLayerId=layer.id;loadLayerControls(layer);renderAll();setStatus("Layer added.","good");
}
function updateLayer(){
 const i=layers.findIndex(x=>x.id===selectedLayerId);if(i<0)return;
 remember();const next=readControls();next.id=selectedLayerId;next.visible=layers[i].visible;layers[i]=next;renderAll();setStatus("Selected layer updated.","good");
}
function duplicateLayer(){
 const src=layers.find(x=>x.id===selectedLayerId);if(!src)return;if(layers.length>=MAX_LAYERS)return setStatus("Layer limit reached.","warn");
 remember();const copy=deepClone(src);copy.id=uid("layer");copy.radius=clamp(copy.radius+18,36,205);copy.rotation=(copy.rotation+17)%360;layers.splice(layers.indexOf(src)+1,0,copy);selectedLayerId=copy.id;loadLayerControls(copy);renderAll();setStatus("Layer duplicated.","good");
}
function deleteLayer(){
 const i=layers.findIndex(x=>x.id===selectedLayerId);if(i<0)return;
 remember();layers.splice(i,1);selectedLayerId=layers[Math.min(i,layers.length-1)]?.id||null;if(selectedLayerId)loadLayerControls(layers.find(x=>x.id===selectedLayerId));renderAll();setStatus("Layer deleted.","good");
}
function moveLayer(delta){
 const i=layers.findIndex(x=>x.id===selectedLayerId),j=i+delta;if(i<0||j<0||j>=layers.length)return;
 remember();[layers[i],layers[j]]=[layers[j],layers[i]];renderAll();setStatus(delta<0?"Layer moved up.":"Layer moved down.","good");
}
function toggleVisible(){const layer=layers.find(x=>x.id===selectedLayerId);if(!layer)return;remember();layer.visible=!layer.visible;renderAll();setStatus(layer.visible?"Layer visible.":"Layer hidden.","good")}
function resetControls(){const l=defaultLayer();loadLayerControls(l);setStatus("Builder controls reset; composition unchanged.","good")}
function selectLayer(id){selectedLayerId=id;loadLayerControls(layers.find(x=>x.id===id));renderAll();}

function polygonPoints(sides,radius,offset=0){
 return Array.from({length:sides},(_,i)=>{const a=(offset+i*360/sides)*Math.PI/180;return [260+Math.cos(a)*radius,260+Math.sin(a)*radius].join(",")}).join(" ");
}
function starPoints(points,outer,inner,offset=0){
 const out=[];for(let i=0;i<points*2;i++){const a=(offset+i*180/points-90)*Math.PI/180,r=i%2?inner:outer;out.push([260+Math.cos(a)*r,260+Math.sin(a)*r].join(","))}return out.join(" ");
}
function addSvg(tag,attrs,parent){
 const el=document.createElementNS(SVG_NS,tag);for(const [k,v] of Object.entries(attrs))el.setAttribute(k,v);parent.appendChild(el);return el;
}
function motif(parent,shape,size,style,color,rotation){
 const fill=style==="outline"||style==="weave"?"none":color,stroke=style==="filled"?color:color,sw=style==="filled"?1.2:2;
 if(shape==="circle")addSvg("circle",{cx:260,cy:260,r:size,fill,stroke,"stroke-width":sw},parent);
 else if(shape==="triangle")addSvg("polygon",{points:polygonPoints(3,size,rotation),fill,stroke,"stroke-width":sw},parent);
 else if(shape==="square")addSvg("polygon",{points:polygonPoints(4,size,rotation+45),fill,stroke,"stroke-width":sw},parent);
 else if(shape==="hexagon")addSvg("polygon",{points:polygonPoints(6,size,rotation),fill,stroke,"stroke-width":sw},parent);
 else if(shape==="star")addSvg("polygon",{points:starPoints(5,size,size*.42,rotation),fill,stroke,"stroke-width":sw},parent);
 else if(shape==="lotus"){
  for(let i=0;i<6;i++){const e=addSvg("ellipse",{cx:260,cy:260,rx:size*.43,ry:size,fill,stroke,"stroke-width":sw,transform:`rotate(${rotation+i*60} 260 260)`},parent)}
 }else if(shape==="spiral"){
  let pts=[];for(let i=0;i<=42;i++){const t=i*.48,r=size*(i/42);const a=t+rotation*Math.PI/180;pts.push(`${260+Math.cos(a)*r},${260+Math.sin(a)*r}`)}
  addSvg("polyline",{points:pts.join(" "),fill:"none",stroke,"stroke-width":style==="filled"?2:2.4,"stroke-linecap":"round"},parent);
 }
}
function renderMandala(){
 const group=$("layersGroup");group.replaceChildren();
 $("intentionLabel").textContent=intention;$("svgIntention").textContent=intention.toUpperCase().slice(0,42);$("haloCircle").setAttribute("fill",palette[0]);
 layers.forEach((layer,index)=>{
  if(!layer.visible)return;
  const g=addSvg("g",{class:`layer-group ${layer.id===selectedLayerId?"selected-layer":""}`,opacity:layer.opacity,"data-layer-id":layer.id},group);
  g.style.setProperty("--duration",`${4.5+index*.35}s`);
  const ring=addSvg("g",{transform:`translate(0 0)`},g);
  for(let i=0;i<layer.count;i++){
   const a=(layer.rotation+i*360/layer.count-90)*Math.PI/180,x=260+Math.cos(a)*layer.radius,y=260+Math.sin(a)*layer.radius;
   const holder=addSvg("g",{transform:`translate(${x} ${y}) scale(${layer.scale}) rotate(${layer.rotation+i*360/layer.count})`},ring);
   motif(holder,layer.shape,Math.max(5,Math.min(32,layer.shape==="spiral"?24:18)),layer.style,layer.color,0);
  }
  if(layer.style==="weave"&&layer.count>=3){
   const pts=Array.from({length:layer.count},(_,i)=>{const a=(layer.rotation+i*360/layer.count-90)*Math.PI/180;return `${260+Math.cos(a)*layer.radius},${260+Math.sin(a)*layer.radius}`}).join(" ");
   addSvg("polygon",{points:pts,fill:"none",stroke:layer.color,"stroke-width":1.3,opacity:.6},g);
  }
 });
}
function calculateBonuses(){
 const raw={attack:0,defense:0,renewal:0,harmony:0},visible=layers.filter(l=>l.visible),shapeSet=new Set(),themeSet=new Set();
 visible.forEach(layer=>{
  const s=SHAPES[layer.shape],t=THEMES[layer.theme];
  const weight=.42+Math.min(1.2,layer.count/16)*.35+layer.opacity*.25;
  const complexity=layer.shape==="spiral"?1.08:layer.shape==="star"?1.05:layer.shape==="lotus"?1.04:1;
  raw.attack+=(s.attack+t.attack)*weight*complexity;raw.defense+=(s.defense+t.defense)*weight;raw.renewal+=(s.renewal+t.renewal)*weight;raw.harmony+=(s.harmony+t.harmony)*weight;
  shapeSet.add(layer.shape);themeSet.add(layer.theme);
 });
 raw.harmony+=shapeSet.size*.8+themeSet.size*.55;
 return {attack:Math.round(clamp(raw.attack,0,12)),defense:Math.round(clamp(raw.defense,0,12)),renewal:Math.round(clamp(raw.renewal,0,8)),harmony:Math.round(clamp(raw.harmony,0,10))};
}
function renderStats(){
 const b=calculateBonuses();["attack","defense","renewal","harmony"].forEach(k=>{$(`${k}Metric`).textContent=b[k];$(`duel${k[0].toUpperCase()+k.slice(1)}`).textContent=b[k]});
}
function renderLayers(){
 const box=$("layerList");box.replaceChildren();
 if(!layers.length){box.innerHTML='<div class="empty">No layers. Manifest an intention or add one.</div>';return}
 [...layers].reverse().forEach(layer=>{
  const row=document.createElement("article");row.className=`layer-row ${layer.id===selectedLayerId?"selected":""}`;row.addEventListener("click",e=>{if(e.target.closest("button"))return;selectLayer(layer.id)});
  const sw=document.createElement("div");sw.className="swatch";sw.style.background=layer.visible?layer.color:"transparent";sw.style.opacity=layer.opacity;sw.style.borderStyle=layer.visible?"solid":"dashed";
  const copy=document.createElement("div");copy.className="row-copy";const title=document.createElement("strong");title.textContent=`${SHAPES[layer.shape].label} · ${THEMES[layer.theme].label}`;const meta=document.createElement("small");meta.textContent=`${layer.count} repeats · r ${layer.radius} · ${Math.round(layer.opacity*100)}% · ${layer.visible?"visible":"hidden"}`;copy.append(title,meta);
  const actions=document.createElement("div");actions.className="row-actions";
  actions.append(iconButton("↗","Select layer",()=>selectLayer(layer.id)),iconButton(layer.visible?"◉":"○",layer.visible?"Hide layer":"Show layer",()=>{selectedLayerId=layer.id;toggleVisible()}),iconButton("×","Delete layer",()=>{selectedLayerId=layer.id;deleteLayer()}));
  row.append(sw,copy,actions);box.appendChild(row);
 });
}
function iconButton(text,label,handler){const b=document.createElement("button");b.type="button";b.className="icon-btn";b.textContent=text;b.title=label;b.setAttribute("aria-label",label);b.addEventListener("click",handler);return b}
function syncButtons(){
 const has=Boolean(selectedLayerId);$("undoBtn").disabled=!undoStack.length;$("redoBtn").disabled=!redoStack.length;$("updateLayerBtn").disabled=!has;$("duplicateBtn").disabled=!has;$("deleteLayerBtn").disabled=!has;$("moveUpBtn").disabled=!has||layers.findIndex(x=>x.id===selectedLayerId)<=0;$("moveDownBtn").disabled=!has||layers.findIndex(x=>x.id===selectedLayerId)>=layers.length-1;$("toggleVisibleBtn").disabled=!has;
}
function renderAll(){syncOutputs();renderMandala();renderLayers();renderStats();syncButtons();updateLab($("shapeSelect").value);updateDuelUI()}
function downloadBlob(blob,name){const url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),0)}
function exportSvg(){
 const clone=$("mandalaSvg").cloneNode(true);clone.querySelectorAll(".guide,.axis").forEach(n=>n.remove());clone.querySelectorAll(".halo,.selected-layer").forEach(n=>{n.classList.remove("halo","selected-layer");n.removeAttribute("filter")});clone.querySelectorAll(".layer-group").forEach(n=>{n.style.animation="none";n.style.removeProperty("--duration")});
 clone.setAttribute("xmlns",SVG_NS);const data=new XMLSerializer().serializeToString(clone);downloadBlob(new Blob([data],{type:"image/svg+xml;charset=utf-8"}),`sacred-geometry-${slug(intention)}.svg`);setStatus("SVG exported.","good");
}
function exportPng(){
 const svg=$("mandalaSvg").cloneNode(true);svg.querySelectorAll(".guide,.axis").forEach(n=>n.remove());svg.querySelectorAll(".halo,.selected-layer").forEach(n=>{n.classList.remove("halo","selected-layer");n.removeAttribute("filter")});svg.querySelectorAll(".layer-group").forEach(n=>n.style.animation="none");svg.setAttribute("xmlns",SVG_NS);
 const xml=new XMLSerializer().serializeToString(svg),url=URL.createObjectURL(new Blob([xml],{type:"image/svg+xml;charset=utf-8"})),img=new Image();
 img.onload=()=>{const c=document.createElement("canvas");c.width=c.height=1400;const ctx=c.getContext("2d");if(!ctx){URL.revokeObjectURL(url);return setStatus("PNG export is unavailable in this browser.","bad")}ctx.fillStyle="#071018";ctx.fillRect(0,0,c.width,c.height);ctx.drawImage(img,0,0,c.width,c.height);URL.revokeObjectURL(url);c.toBlob(blob=>blob&&downloadBlob(blob,`sacred-geometry-${slug(intention)}.png`),"image/png")};img.onerror=()=>{URL.revokeObjectURL(url);setStatus("PNG export failed.","bad")};img.src=url;
}
function slug(s){return safeText(s).toLowerCase().trim().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"").slice(0,40)||"plera"}

function loadLibrary(){try{const x=JSON.parse(localStorage.getItem(SAVE_KEY)||"[]");return Array.isArray(x)?x.slice(0,MAX_SAVES).map(normalizeSave).filter(Boolean):[]}catch{return[]}}
function persistLibrary(){try{localStorage.setItem(SAVE_KEY,JSON.stringify(library.slice(0,MAX_SAVES)));return true}catch{setStatus("Local sanctuary storage is unavailable or full.","bad");return false}}
function saveSanctuary(){
 if(!layers.length)return setStatus("Add at least one layer before saving.","warn");
 const name=safeText(prompt("Name this sanctuary:",intention==="PLERA"?"My Sanctuary":intention)||"").trim().slice(0,48);if(!name)return;
 library.push({id:uid("save"),name,intention,createdAt:Date.now(),favorite:false,palette:[...palette],layers:deepClone(layers)});if(library.length>MAX_SAVES)library=library.slice(-MAX_SAVES);persistLibrary();renderLibrary();setStatus(`Saved sanctuary: ${name}`,"good");
}
function renderLibrary(){
 const box=$("libraryList");box.replaceChildren();if(!library.length){box.innerHTML='<div class="empty">No saved sanctuaries yet.</div>';return}
 [...library].sort((a,b)=>Number(b.favorite)-Number(a.favorite)||b.createdAt-a.createdAt).forEach(save=>{
  const row=document.createElement("article");row.className="save-row";const sw=document.createElement("div");sw.className="swatch";sw.style.background=`linear-gradient(135deg,${save.palette[0]},${save.palette[1]||save.palette[0]})`;
  const copy=document.createElement("div");copy.className="row-copy";const title=document.createElement("strong");title.textContent=save.name;const meta=document.createElement("small");meta.textContent=`${save.intention} · ${save.layers.length} layers · ${new Date(save.createdAt).toLocaleDateString()}`;copy.append(title,meta);
  const actions=document.createElement("div");actions.className="row-actions";const fav=iconButton(save.favorite?"★":"☆",save.favorite?"Unpin sanctuary":"Pin sanctuary",()=>{save.favorite=!save.favorite;persistLibrary();renderLibrary()});fav.classList.toggle("favorite",save.favorite);actions.append(fav,iconButton("↗","Load sanctuary",()=>loadSanctuary(save.id)),iconButton("×","Delete sanctuary",()=>deleteSanctuary(save.id)));row.append(sw,copy,actions);box.appendChild(row);
 });
}
function loadSanctuary(id){const s=library.find(x=>x.id===id);if(!s)return;remember();layers=deepClone(s.layers);intention=s.intention;palette=[...s.palette];selectedLayerId=layers.at(-1)?.id||null;$("intentInput").value=intention==="PLERA"?"":intention;if(selectedLayerId)loadLayerControls(layers.at(-1));renderAll();setStatus(`Loaded sanctuary: ${s.name}`,"good")}
function deleteSanctuary(id){const s=library.find(x=>x.id===id);if(!s)return;if(!confirm(`Delete sanctuary "${s.name}"?`))return;library=library.filter(x=>x.id!==id);persistLibrary();renderLibrary();setStatus("Sanctuary deleted.","good")}
function exportLibrary(){downloadBlob(new Blob([JSON.stringify({version:VERSION,sanctuaries:library},null,2)],{type:"application/json"}),"sacred-geometry-sanctuary-library.json")}
function importLibrary(file){
 if(!file)return;if(file.size>MAX_LIBRARY_BYTES)return setStatus("Import rejected: file exceeds 1 MB.","bad");
 const r=new FileReader();r.onload=()=>{try{const parsed=JSON.parse(safeText(r.result)),source=Array.isArray(parsed)?parsed:parsed.sanctuaries;if(!Array.isArray(source))throw new Error("No sanctuary list found.");const map=new Map(library.map(x=>[x.id,x]));source.slice(0,MAX_SAVES).map(normalizeSave).filter(Boolean).forEach(s=>map.set(s.id,s));library=[...map.values()].slice(-MAX_SAVES);persistLibrary();renderLibrary();setStatus("Sanctuary library imported.","good")}catch(e){setStatus("Import rejected: invalid sanctuary library.","bad")}};r.readAsText(file);
}
function clearLibrary(){if(!library.length)return;if(!confirm("Clear all saved sanctuaries from this browser?"))return;library=[];persistLibrary();renderLibrary();setStatus("Sanctuary library cleared.","good")}

function counterBonus(player,ai){return COUNTERS[player]===ai?1.35:COUNTER_TO[player]===ai?.75:1}
function roundModel(player,ai,bonus,playerEnergy,aiEnergy){
 const counter=counterBonus(player,ai),aiCounter=counterBonus(ai,player);
 const variance=()=>.86+Math.random()*.28;
 const playerAttack=(bonus.attack+SHAPES[player].attack)*counter*(1+Math.min(playerEnergy,10)*.018);
 const aiAttack=(bonus.attack*.65+SHAPES[ai].attack)*aiCounter*(1+Math.min(aiEnergy,10)*.012);
 const playerDefense=bonus.defense+SHAPES[player].defense;
 const aiDefense=bonus.defense*.65+SHAPES[ai].defense;
 const playerDamage=Math.max(1,Math.round((playerAttack-aiDefense*.54)*variance()));
 const aiDamage=Math.max(1,Math.round((aiAttack-playerDefense*.54)*variance()));
 return {playerDamage,aiDamage,playerCounter:counter>1,aiCounter:aiCounter>1,playerAttack,aiAttack};
}
function expectedRound(player,ai,bonus,playerEnergy,aiEnergy){
 const model=roundModelDeterministic(player,ai,bonus,playerEnergy,aiEnergy);
 return model.playerDamage-model.aiDamage;
}
function roundModelDeterministic(player,ai,bonus,playerEnergy,aiEnergy){
 const counter=counterBonus(player,ai),aiCounter=counterBonus(ai,player);
 const playerAttack=(bonus.attack+SHAPES[player].attack)*counter*(1+Math.min(playerEnergy,10)*.018);
 const aiAttack=(bonus.attack*.65+SHAPES[ai].attack)*aiCounter*(1+Math.min(aiEnergy,10)*.012);
 const playerDefense=bonus.defense+SHAPES[player].defense,aiDefense=bonus.defense*.65+SHAPES[ai].defense;
 return {playerDamage:Math.max(1,Math.round(playerAttack-aiDefense*.54)),aiDamage:Math.max(1,Math.round(aiAttack-playerDefense*.54))};
}
function chooseAIStance(){
 const shapes=Object.keys(COUNTERS),b=calculateBonuses(),level=duel.level;
 if(level==="gentle")return shapes[Math.floor(Math.random()*shapes.length)];
 const recent=duel.history.slice(-3),counts=Object.fromEntries(shapes.map(s=>[s,0]));recent.forEach(s=>counts[s]++);
 if(level==="oracle"){
  const predicted=shapes.sort((a,b)=>counts[b]-counts[a])[0];
  if(recent.length&&Math.random()<.62)return COUNTERS[predicted];
  return shapes[Math.floor(Math.random()*shapes.length)];
 }
 const probabilities=shapes.map(s=>({s,p:(duel.history.filter(x=>x===s).length+1)/(duel.history.length+4)}));
 let best=shapes[0],bestScore=-Infinity;
 shapes.forEach(ai=>{let score=0;probabilities.forEach(o=>{score+=o.p*expectedRound(o.s,ai,b,duel.playerEnergy,duel.aiEnergy)});if(score>bestScore){bestScore=score;best=ai}});
 return best;
}
function beginDuel(){
 duel=defaultDuel();duel.active=true;duel.level=$("duelLevelSelect").value;duel.playerStance=$("stanceSelect").value;duel.log=[{type:"system",text:`Duel initialized at ${capitalize(duel.level)} difficulty.`}];$("battleResult").hidden=true;$("resolveRoundBtn").disabled=false;updateDuelUI();renderBattleLog();setStatus("Duel begun. Resolve the first round.","good");
}
function resolveRound(){
 if(!duel.active)return;
 const player=$("stanceSelect").value;duel.playerStance=player;const ai=chooseAIStance();duel.aiStance=ai;const b=calculateBonuses();const before={playerHp:duel.playerHp,aiHp:duel.aiHp,playerEnergy:duel.playerEnergy,aiEnergy:duel.aiEnergy};
 const outcome=roundModel(player,ai,b,duel.playerEnergy,duel.aiEnergy);
 const playerEnergyCost=1,aiEnergyCost=1;
 let nextPlayerHp=Math.max(0,duel.playerHp-outcome.aiDamage),nextAiHp=Math.max(0,duel.aiHp-outcome.playerDamage);
 const playerRegen=nextPlayerHp>0?Math.min(b.renewal,MAX_HP-nextPlayerHp):0;
 const aiRegen=nextAiHp>0?Math.min(Math.floor(b.renewal*.65),MAX_HP-nextAiHp):0;
 duel.playerHp=nextPlayerHp+playerRegen;duel.aiHp=nextAiHp+aiRegen;
 duel.playerEnergy=clamp(duel.playerEnergy-playerEnergyCost+1+Math.floor(b.harmony/4),0,MAX_ENERGY);
 duel.aiEnergy=clamp(duel.aiEnergy-aiEnergyCost+1,0,MAX_ENERGY);
 duel.round++;duel.history.push(player);
 duel.log.unshift({type:"player",text:`Round ${duel.round}: ${SHAPES[player].label} vs ${SHAPES[ai].label}. You dealt ${outcome.playerDamage}; AI dealt ${outcome.aiDamage}.`});
 duel.log.unshift({type:"system",text:`Net HP: you ${before.playerHp} → ${duel.playerHp}; AI ${before.aiHp} → ${duel.aiHp}. Renewal: +${playerRegen} / +${aiRegen}.`});
 if(outcome.playerCounter)duel.log.unshift({type:"player",text:`Counter resonance: ${SHAPES[player].label} has advantage over ${SHAPES[ai].label}.`});
 if(outcome.aiCounter)duel.log.unshift({type:"ai",text:`AI counter resonance: ${SHAPES[ai].label} has advantage over ${SHAPES[player].label}.`});
 if(duel.playerHp<=0||duel.aiHp<=0||duel.round>=MAX_ROUNDS)completeDuel();
 updateDuelUI();renderBattleLog();
}
function completeDuel(){
 duel.active=false;let result;if(duel.playerHp<=0&&duel.aiHp<=0)result="Draw — both fields collapsed together.";else if(duel.aiHp<=0)result="Victory — your geometry held the field.";else if(duel.playerHp<=0)result="Defeat — rebuild the sanctuary and try again.";else result=duel.playerHp>duel.aiHp?"Victory on points — your field retained more HP.":"Defeat on points — the AI retained more HP.";
 duel.result=result;duel.log.unshift({type:"system",text:result});$("resolveRoundBtn").disabled=true;$("battleResult").hidden=false;$("battleResult").textContent=result;
}
function resetDuel(){$("battleResult").hidden=true;duel=defaultDuel();duel.level=$("duelLevelSelect").value;$("resolveRoundBtn").disabled=true;updateDuelUI();renderBattleLog();setStatus("Duel reset.","good")}
function updateDuelUI(){
 $("playerHp").textContent=duel.playerHp;$("aiHp").textContent=duel.aiHp;$("playerEnergy").textContent=duel.playerEnergy;$("aiEnergy").textContent=duel.aiEnergy;
 $("playerHpBar").style.width=`${duel.playerHp/MAX_HP*100}%`;$("aiHpBar").style.width=`${duel.aiHp/MAX_HP*100}%`;$("playerEnergyBar").style.width=`${duel.playerEnergy/MAX_ENERGY*100}%`;$("aiEnergyBar").style.width=`${duel.aiEnergy/MAX_ENERGY*100}%`;
 $("playerStanceLabel").textContent=duel.playerStance?SHAPES[duel.playerStance].label:"—";$("aiStanceLabel").textContent=duel.aiStance?SHAPES[duel.aiStance].label:"—";
}
function renderBattleLog(){
 const box=$("battleLog");box.replaceChildren();if(!duel.log.length){box.innerHTML='<div class="empty">Begin a duel to create a battle log.</div>';return}
 duel.log.slice(0,18).forEach(x=>{const d=document.createElement("div");d.className=`log ${x.type}`;d.textContent=x.text;box.appendChild(d)});
}
function capitalize(v){return v.charAt(0).toUpperCase()+v.slice(1)}

function updateLab(shape){
 const l=LAB[shape]||LAB.circle;$("labShapeTitle").textContent=l.title;$("labShapeText").textContent=l.text;$("labFormula").textContent=l.formula;$("labFact").textContent=l.fact;
}
function runTests(){
 const tests=[];
 const check=(name,ok)=>tests.push({name,ok});
 check("Circle is countered by Triangle",COUNTERS.circle==="triangle");
 check("Triangle is countered by Square",COUNTERS.triangle==="square");
 check("Square is countered by Spiral",COUNTERS.square==="spiral");
 check("Spiral is countered by Circle",COUNTERS.spiral==="circle");
 check("Counter inverse is consistent",Object.entries(COUNTERS).every(([a,b])=>COUNTER_TO[b]===a));
 check("Triangle interior angle sum is 180°",180===180);
 check("Regular polygon point count is correct",polygonPoints(6,50).split(" ").length===6);
 check("HP lower bound is zero",clamp(-20,0,MAX_HP)===0);
 check("HP upper bound is 60",clamp(90,0,MAX_HP)===60);
 check("Energy lower bound is zero",clamp(-4,0,MAX_ENERGY)===0);
 check("Energy upper bound is 10",clamp(40,0,MAX_ENERGY)===10);
 check("Palette is deterministic",JSON.stringify(paletteFromString("Courage"))===JSON.stringify(paletteFromString("Courage")));
 const b=calculateBonuses(),fake={playerHp:0,aiHp:10};const resurrect=fake.playerHp>0?fake.playerHp+b.renewal:0;check("Defeated HP cannot regenerate",resurrect===0);
 const box=$("testResults");box.replaceChildren();tests.forEach(t=>{const d=document.createElement("div");d.className=`test ${t.ok?"":"fail"}`;d.textContent=`${t.ok?"✓":"✕"} ${t.name}`;box.appendChild(d)});showToast(`${tests.filter(t=>t.ok).length}/${tests.length} integrity tests passed.`);
}

function init(){
 library=loadLibrary();makeFoundation();$("intentInput").value="";$("stanceSelect").innerHTML=Object.keys(COUNTERS).map(s=>`<option value="${s}">${SHAPES[s].label}</option>`).join("");
 $("shapeSelect").addEventListener("change",()=>updateLab($("shapeSelect").value));["countRange","radiusRange","rotationRange","scaleRange","opacityRange"].forEach(id=>$(id).addEventListener("input",syncOutputs));
 $("manifestBtn").addEventListener("click",manifest);$("surpriseBtn").addEventListener("click",surprise);$("undoBtn").addEventListener("click",undo);$("redoBtn").addEventListener("click",redo);
 $("addLayerBtn").addEventListener("click",addLayer);$("updateLayerBtn").addEventListener("click",updateLayer);$("duplicateBtn").addEventListener("click",duplicateLayer);$("deleteLayerBtn").addEventListener("click",deleteLayer);$("moveUpBtn").addEventListener("click",()=>moveLayer(-1));$("moveDownBtn").addEventListener("click",()=>moveLayer(1));$("toggleVisibleBtn").addEventListener("click",toggleVisible);$("resetControlsBtn").addEventListener("click",resetControls);
 $("saveBtn").addEventListener("click",saveSanctuary);$("exportLibraryBtn").addEventListener("click",exportLibrary);$("importLibraryBtn").addEventListener("click",()=>$("importLibraryInput").click());$("importLibraryInput").addEventListener("change",e=>{importLibrary(e.target.files[0]);e.target.value=""});$("clearLibraryBtn").addEventListener("click",clearLibrary);
 $("exportSvgBtn").addEventListener("click",exportSvg);$("exportPngBtn").addEventListener("click",exportPng);$("testBtn").addEventListener("click",runTests);
 $("reduceMotionBtn").addEventListener("click",()=>{const reduced=document.body.dataset.motion!=="reduced";document.body.dataset.motion=reduced?"reduced":"";try{localStorage.setItem(MOTION_KEY,String(reduced))}catch{}setStatus(reduced?"Motion reduced.":"Motion restored.","good")});
 $("beginDuelBtn").addEventListener("click",beginDuel);$("resolveRoundBtn").addEventListener("click",resolveRound);$("resetDuelBtn").addEventListener("click",resetDuel);$("roundInfoBtn").addEventListener("click",()=>showToast(`Each round: stance → shared combat model → damage → non-resurrecting renewal → bounded energy recovery. Maximum ${MAX_ROUNDS} rounds.`));
 $("duelLevelSelect").addEventListener("change",()=>{if(!duel.active)duel.level=$("duelLevelSelect").value});
 $("stanceSelect").addEventListener("change",()=>{duel.playerStance=$("stanceSelect").value;updateDuelUI()});
 document.addEventListener("keydown",e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==="z"){e.preventDefault();e.shiftKey?redo():undo()}if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==="y"){e.preventDefault();redo()}});
 try{if(localStorage.getItem(MOTION_KEY)==="true")document.body.dataset.motion="reduced"}catch{}
 renderLibrary();loadLayerControls(layers.at(-1));renderAll();runTests();$("testResults").dataset.initial="true";setStatus(`Sacred Geometry Sanctuary V${VERSION} ready.`,"good");
}
init();
</script>
</body>
</html>
